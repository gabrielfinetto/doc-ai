{
  "manifest_version": 3,
  "name": "DocIA - Captura Full Page Pro",
  "version": "1.5.1",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://*.easypanel.host/*",
    "https://*.n8n.cloud/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
  "16": "icon-16.png",
  "48": "icon-48.png",
  "128": "icon-128.png"
}
}

